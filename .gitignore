# Ignore everything by default (whitelist approach)
*

# Always track this file
!.gitignore

# Root-level code files
!*.py
!*.r
!*.R

# cursorrules config
!cursorrules

# --- BlenderConvert ---
!BlenderConvert/
BlenderConvert/*
!BlenderConvert/*.py

# --- CSVconvert ---
!CSVconvert/
CSVconvert/*
!CSVconvert/*.py

# --- viz (bulk DEM preprocess) ---
!viz/
viz/*
!viz/*.py

# --- Data analysis (legacy prototypes; migrated 2026-09-25) ---
!Data analysis/
Data analysis/*
!Data analysis/*.py
!Data analysis/*.sh

# --- Rcode ---
!Rcode/
Rcode/*
!Rcode/*.r
!Rcode/*.R

# --- Context docs + repo config (tracked since the 2026-09-25 move to WSL) ---
# Re-include only the doc dirs -- not */ -- so a venv, a Claude worktree or a
# stray data folder inside this repo stays ignored.
!docs/
!docs/**/
!.cursor/
!.cursor/rules/
!*.md
!*.mdc
!.gitattributes
!.cursorignore

# Generated by P0_InstancingSpike.py into the OneDrive docs/ folder (with p0_renders/).
docs/P0_INSTANCING_SPIKE.md
